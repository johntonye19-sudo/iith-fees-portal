# Example env for IITH Fees API (copy to .env and edit)

# Paystack secret key (sk_test_... or sk_live_...)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional separate webhook secret (if set in Paystack webhook configuration).
# If not set, the server will fall back to PAYSTACK_SECRET_KEY.
PAYSTACK_WEBHOOK_SECRET=

# Restrict which frontends the API accepts requests from (comma separated) or '*' for all
FRONTEND_ORIGIN=*

# Bursary API token used by the demo bursary page (change in production)
BURSARY_API_TOKEN=dev-bursary-token

# Serve the static frontend from the repo root (set to 1 in production if desired)
SERVE_STATIC=0

# Port to run the server on
PORT=3000
